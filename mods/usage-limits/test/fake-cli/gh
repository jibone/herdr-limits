#!/bin/sh
[ "$1 $2" = "api /copilot_internal/user" ] || exit 2
case "${FAKE_GH:-ok}" in
  missing) echo "HTTP 404: Not Found (https://api.github.com/copilot_internal/user)" >&2; exit 1 ;;
  token) [ "$GH_TOKEN" = from-login-shell ] || { echo "To get started with GitHub CLI, please run:  gh auth login" >&2; exit 4; } ;;
  signedout) echo "To get started with GitHub CLI, please run:  gh auth login" >&2; exit 4 ;;
esac
echo '{"plan":"business","quotas":{"premium_interactions":{"percent_remaining":34.2}},"reset":"2026-12-01"}'
