#!/bin/sh
here=$(dirname "$0")
if [ "$1 $2 $3" = "api GET /api/experimental/usage/limits" ]; then
  case "${FAKE_OPENCODE_GO:-go}" in
    go) cat "$here/../fixtures/opencode-go-limits.json" ;;
    signedout) echo '{"location":{"directory":"/home/demo"},"data":null}' ;;
    nogo) echo '{"location":{"directory":"/home/demo"},"data":{"workspace":{"id":"w","usageURL":"u"},"budgets":[]}}' ;;
    down) echo '{"message":"OpenCode Console usage limits timed out","service":"opencode"}'; exit 1 ;;
    hang) exec sleep 58 ;;
  esac
  exit 0
fi
days=
while [ $# -gt 0 ]; do
  if [ "$1" = "--days" ]; then days=$2; fi
  shift
done
case "$FAKE_OPENCODE" in
  hang) while :; do sleep 1; done ;;
  stubborn) trap "" TERM; while :; do sleep 1; done ;;
  fail) echo "boom" >&2; exit 1 ;;
  banner) echo "A new version of opencode is available: 9.9.9" ;;
esac
if [ "$days" = "0" ]; then cat "$here/../fixtures/opencode-stats.today.json"
else cat "$here/../fixtures/opencode-stats.week.json"; fi
